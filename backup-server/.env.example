# Copy to .env (local) or set these as environment variables on the host.
# Never commit real values. Never put these in the CitiSense app .env.

# Supabase project (source of the backup)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Connect -> Session pooler URI (port 5432)
SUPABASE_DB_URL=

# Public address of this backup server (used for download links)
PUBLIC_URL=https://your-backup-server.example.com

# Random long string, e.g. `openssl rand -hex 32`
DOWNLOAD_SIGNING_SECRET=

# Break-glass key for the recovery team when Supabase login is down
# (`openssl rand -hex 32`). Store it in a sealed envelope / password manager.
EMERGENCY_ACCESS_KEY=

# Web app origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5050

# Optional tuning
BACKUP_DIR=/data/backups
BACKUP_BUCKETS=complaint-photos,avatars,validation-photos
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=Asia/Manila
BACKUP_RPO_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3
DOWNLOAD_LINK_MINUTES=10
